{
  "$comment": "Where `npm run build` reads the latest release. See README.md 'Release metadata'. provider: \"latest-json\" (the release's latest.json, default), \"github\" (the releases API) or \"url\".",
  "provider": "latest-json",
  "github": {
    "owner": "vestrasys",
    "repo": "vestra-player"
  },
  "url": {
    "$comment": "provider \"url\": a JSON file in the format of README.md 'The url provider'; asset URLs in it may be relative to it.",
    "manifest": null
  },
  "includePrereleases": false,
  "stableAssetNames": false,
  "releasesPage": "https://github.com/vestrasys/vestra-player/releases",
  "fallbackVersion": null,
  "assets": [
    {
      "id": "windows-setup",
      "os": "windows",
      "arch": "x64",
      "kind": "installer",
      "pattern": "^VestraPlayer-.+-windows-x64-setup\\.exe$",
      "stableName": "VestraPlayer-windows-x64-setup.exe",
      "enabled": true,
      "latestKey": "windows-x64"
    },
    {
      "id": "windows-portable",
      "os": "windows",
      "arch": "x64",
      "kind": "portable",
      "pattern": "^VestraPlayer-.+-windows-x64-portable\\.zip$",
      "stableName": "VestraPlayer-windows-x64-portable.zip",
      "enabled": true
    },
    {
      "id": "macos-arm64",
      "os": "macos",
      "arch": "arm64",
      "kind": "dmg",
      "pattern": "^VestraPlayer-.+-macos-arm64\\.dmg$",
      "stableName": "VestraPlayer-macos-arm64.dmg",
      "enabled": true,
      "latestKey": "macos-arm64"
    },
    {
      "id": "macos-x64",
      "os": "macos",
      "arch": "x64",
      "kind": "dmg",
      "pattern": "^VestraPlayer-.+-macos-x64\\.dmg$",
      "stableName": "VestraPlayer-macos-x64.dmg",
      "enabled": false,
      "latestKey": "macos-x64"
    },
    {
      "id": "macos-universal",
      "os": "macos",
      "arch": "universal",
      "kind": "dmg",
      "pattern": "^VestraPlayer-.+-macos-universal\\.dmg$",
      "stableName": "VestraPlayer-macos-universal.dmg",
      "enabled": false,
      "latestKey": "macos-universal"
    }
  ],
  "requirements": {
    "windows": {
      "en": "Windows 10 or 11, 64-bit (x64)",
      "zh-Hans": "Windows 10 或 11，64 位（x64）"
    },
    "macos": {
      "en": "macOS 15 Sequoia or later, Apple silicon (M1 or newer)",
      "zh-Hans": "macOS 15 Sequoia 或更高版本，Apple 芯片（M1 或更新）"
    }
  }
}
